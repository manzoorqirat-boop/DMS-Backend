# Copy to .env for docker compose. Never commit the filled-in version.
#
# Every value below is a development placeholder. In a deployed environment these belong in a
# secret store, not a file — and Jwt__SigningKey in particular is the only thing standing
# between a stranger and a token that passes every permission check in the system.

POSTGRES_PASSWORD=dev_only

# Minimum 32 characters. Startup fails if shorter.
JWT_SIGNING_KEY=dev-only-signing-key-not-for-production-use
EDITOR_TOKEN_SECRET=dev-only-editor-token-secret-32-chars

# Seeded only when the user table is empty. Change the password immediately after first run
# and remove these.
ADMIN_USER=admin
ADMIN_PASSWORD=ChangeMeOnFirstRun!
