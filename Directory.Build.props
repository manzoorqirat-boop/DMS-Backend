<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- NU1604/NU1605 are a known false-positive class specifically under Central Package
         Management: they fire on every `<PackageReference Include="X" />` with no Version
         attribute — which is exactly how a CPM reference is written — regardless of whether
         Directory.Packages.props correctly pins that package elsewhere. Left under
         TreatWarningsAsErrors, they turn every single package reference in the solution into
         a hard restore failure the moment restore actually runs against a real feed, which is
         what surfaced this. Demoted here, and only here — NU1902/NU1903 (actual known
         vulnerability advisories) are deliberately NOT included in this list, since silencing
         those would trade a real supply-chain safety gate for a quieter build log. -->
    <WarningsNotAsErrors>NU1604;NU1605</WarningsNotAsErrors>

    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
